[Unit]
Description=MOPAT Web-App (webapp-container)
After=db-container.service
Requires=db-container.service

[Service]
Restart=always

[Container]
Image=docker.io/wwuimi/mopat:3.2.5
ContainerName=webapp-container

# Ports (nur localhost)
PublishPort=127.0.0.1:8080:8080

# Volumes
Volume=/data/export/HL7:/var/lib/tomcat10/export/HL7:rw
Volume=/data/export/FHIR:/var/lib/tomcat10/export/FHIR:rw
Volume=/data/export/ODM:/var/lib/tomcat10/export/ODM:rw
Volume=/data/upload:/var/lib/tomcat10/upload:rw
Volume=/data/images:/var/lib/tomcat10/images:rw
Volume=/data/config:/etc/mopat:ro
Volume=%h/.config/containers/systemd/mopat/server.xml:/usr/local/tomcat/conf/server.xml:ro

# Labels
Label=traefik.docker.network=klinik
Label="traefik.http.routers.mopat.rule=Host(`k-sql-mopat-2.klinik.um-mz.de`) && PathPrefix(`/`)"
Label=traefik.http.routers.mopat.entrypoints=websecure
Label=traefik.http.routers.mopat.tls=true
Label=traefik.http.services.mopat.loadbalancer.server.port=8080

# Environments
Environment=MYSQL_MOPAT_URL=jdbc:mysql://db-container:3306/moPat?autoReconnect=true&useUnicode=true&useEncoding=true&characterEncoding=UTF-8
Environment=MYSQL_MOPAT_USER_URL=jdbc:mysql://db-container:3306/moPat_user?autoReconnect=true&useUnicode=true&useEncoding=true&characterEncoding=UTF-8
Environment=MYSQL_MOPAT_AUDIT_URL=jdbc:mysql://db-container:3306/moPat_audit?autoReconnect=true&useUnicode=true&useEncoding=true&characterEncoding=UTF-8
Environment=MOPAT_SMTP_HOST=smtp.host.com
Environment=MOPAT_SMTP_FROM=replaceme@domain.com
Environment=MOPAT_SMTP_TO=replaceme@domain.com
# Replace with Secret after creating a new admin user and configuring the mail daemon
Environment=PEPPER=AdP5ktlaIVaon53yJg8zEZSnFr33Dinil69ZtZMTWXubKMUEpfyNvOgWLdwNLhedY3WT5TVcqgg

# Secrets → werden als Umgebungsvariablen bereitgestellt
Secret=MARIADB_PASSWORD,type=env,target=MYSQL_PASSWORD
Secret=MARIADB_USER,type=env,target=MYSQL_USER
Secret=PEPPER,type=env,target=PEPPER

[Install]
#Start by default on boot
WantedBy=multi-user.target default.target
